//------------------------------------------------------------------------------------------------
// PLAYER SETUP MENU  - ingame_player
//
//	Choose player skin, name
//	Choose light saber
//	Allocate force powers
//
//	g_gametypes
//		"Free For All" 		0
//		"Duel" 			3
//		"Power Duel" 		4
//		"Team FFA" 		6 
//		"Siege" 		7
//		"Capture the Flag" 	8
//
//	ui_net_gametype
//		0 = FFA
//		1 = DUEL
//		2 = POWER DUEL
//		3 = TEAM FFA
//		4 = SIEGE
//		5 = CTF
//------------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name						"ingame_player"
		visible						0
		fullscreen					0
		outOfBoundsClick										// this closes the window if it gets a click out of the rectangle
		rect						195 140 250 215		// GalaxyRP: [Profile UI] grown taller (was 180) to fit the Join Red/Join Blue buttons below Join/Spectate
		focusColor					1 1 1 1					// Focus color for text and items
		style						1
		border						1
		descX						320
		descY						428
		descScale					1
		descColor				1 .682 0 .8
		descAlignment					ITEM_ALIGN_CENTER		
		onOpen  
		{ 
			uiScript				update "ui_GetName"
			uiScript				updateForceStatus
			hide					highlights
		}
		onClose 
		{ 
			uiScript				update "ui_SetName"
			uiScript				updateForceStatus
			hide					highlights
		}

//------------------------------------------------------------------------------------------------
// Overall window backdrop
//------------------------------------------------------------------------------------------------
		itemDef 
		{
			name				background_pic
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 250 215
			background			"gfx/menus/menu_box_ingame"
			forecolor			1 1 1 1
			visible				1
			decoration
		}


		// Button background at bottom of screen
		itemDef 
		{
			name				background
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 420 600 20
			backcolor			.298 .305 .690 1
			forecolor			.549 .854 1 1
			visible				1
			decoration
		}

//------------------------------------------------------------------------------------------------
// Name entry field
//------------------------------------------------------------------------------------------------
		itemDef 
		{
			name				nameglow
			group				mods
			style				WINDOW_STYLE_SHADER
			rect				25 11 250 24
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			visible			0
			decoration
		}
		
		itemDef 
		{
			name 				namefield
			type 				ITEM_TYPE_EDITFIELD
			style 				0
			text 				@MENUS_NAME1
			cvar 				"ui_Name"
			maxchars 			26
			rect 				20 13 170 20
			textalign			ITEM_ALIGN_LEFT		
			textalignx 			0
			textaligny 			-5
			font				2
			textscale			1
			forecolor			1 .682 0 1
			outlinecolor 			1 .5 .5 .5
			backcolor 			0 0 0 0
			border 				0
			bordercolor 			0 0 0 0
			descText			@MENUS_ENTER_YOUR_NAME_HERE
			visible 			1 
			action 
			{ 
				play			"sound/interface/button1"
			}
			mouseenter 
			{ 
				show			nameglow
			}
			mouseexit 
			{ 
				hide			nameglow
			}
		}
//LOG IN BUTTONS
		itemDef 
		{
			name				loginButton
			group				highlights 
			style				WINDOW_STYLE_SHADER
			rect				73 70 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
		}

		itemDef 
		{
			name				login
			group				"playerforcespectate"
			text				"Log in"
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				73 70 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			descText			@MENUS_APPLY_CHANGES_BUT_REMAIN
			visible			1
			action 
			{ 
				play			"sound/interface/button1"
				open			ingame_login
				close 			ingame_player
			}
			mouseEnter 
			{ 
				show			loginButton
			}
			mouseExit 
			{ 
				hide			loginButton
			}
		}

//REGISTER BUTTONS

		itemDef 
		{
			name				registerButton
			group				highlights 
			style				WINDOW_STYLE_SHADER
			rect				73 40 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
		}

		itemDef 
		{
			name				register
			group				"playerforcespectate"
			text				"Register"
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				73 40 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			descText			@MENUS_APPLY_CHANGES_BUT_REMAIN
			visible			1
			action 
			{ 
				play			"sound/interface/button1"
				open			ingame_register
				close 			ingame_player
			}
			mouseEnter 
			{ 
				show			registerButton
			}
			mouseExit 
			{ 
				hide			registerButton
			}
		}

//REGISTER BUTTONS

		itemDef 
		{
			name				changepassButton
			group				highlights 
			style				WINDOW_STYLE_SHADER
			rect				73 100 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
		}

		itemDef 
		{
			name				changepass
			group				"playerforcespectate"
			text				"Change Pass"
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				73 100 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			descText			@MENUS_APPLY_CHANGES_BUT_REMAIN
			visible			1
			action 
			{ 
				play			"sound/interface/button1"
				open			ingame_passchange
				close 			ingame_player
			}
			mouseEnter 
			{ 
				show			changepassButton
			}
			mouseExit 
			{ 
				hide			changepassButton
			}
		}

//---------------------------------------------
//	APPLY BUTTON
//---------------------------------------------
// JOIN BUTTONS
		itemDef 
		{
			name				applyjoinButton
			group				highlights 
			style				WINDOW_STYLE_SHADER
			rect				5 140 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
			appearance_slot		3
		}

		// GalaxyRP: [Profile UI] simplified from the old two-clone playerapply/playerforcejoin setup
		// (which routed through uiScript setForce, and so silently did nothing whenever gTouchedForce
		// happened to be false) down to a single button with the exact same plain team-join command
		// the top-bar Join menu's own Join button uses, so it now works reliably every time.
		// GalaxyRP: [Team modes] hidden for Team FFA/CTF (g_gametype 6/8) in favor of the "Auto team"
		// variant below, matching the now-hidden top-bar Join menu's own labeling convention.
		itemDef
		{
			name				applyjoin
			group				none
			text				"Join Game"
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				5 140 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			descText			@MENUS_APPLY_CHANGES_AND_JOIN
			cvartest			"g_gametype"
			hidecvar			{ "6", "8" }
			visible			1
			action
			{
				play			"sound/interface/button1"
				exec			"cmd team free"
				hide			highlights
				uiScript 		closeingame
			}
			mouseEnter
			{
				show			applyjoinButton
			}
			mouseExit
			{
				hide			applyjoinButton
			}
		}

		// GalaxyRP: [Team modes] "Auto team" variant of applyjoin, shown only for Team FFA/CTF -- same
		// rect/button and same "cmd team free" action (which auto-balances via PickTeam() server-side
		// for these gametypes), just relabeled to match the now-hidden top-bar Join menu's convention.
		itemDef
		{
			name				applyjoinauto
			group				none
			text				"Auto team"
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				5 140 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			descText			@MENUS_APPLY_CHANGES_AND_JOIN
			cvartest			"g_gametype"
			showcvar			{ "6", "8" }
			visible			1
			action
			{
				play			"sound/interface/button1"
				exec			"cmd team free"
				hide			highlights
				uiScript 		closeingame
			}
			mouseEnter
			{
				show			applyjoinButton
			}
			mouseExit
			{
				hide			applyjoinButton
			}
		}

// JOIN RED / JOIN BLUE BUTTONS (Team FFA / CTF only)
		itemDef
		{
			name				applyjoinredButton
			group				highlights
			style				WINDOW_STYLE_SHADER
			rect				5 175 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
			cvartest			"g_gametype"
			showcvar			{ "6", "8" }
		}

		// GalaxyRP: [Team modes] manual Red team pick for Team FFA/CTF -- restores the functionality the
		// now-hidden top-bar Join menu used to provide, now reachable from the Account menu instead.
		itemDef
		{
			name				applyjoinred
			group				none
			text				@MENUS_TEAM_RED
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				5 175 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 0.2 0.2 1
			descText			@MENUS_APPLY_CHANGES_AND_JOIN
			cvartest			"g_gametype"
			showcvar			{ "6", "8" }
			visible			1
			action
			{
				play			"sound/interface/button1"
				exec			"cmd team red"
				hide			highlights
				uiScript 		closeingame
			}
			mouseEnter
			{
				show			applyjoinredButton
			}
			mouseExit
			{
				hide			applyjoinredButton
			}
		}

		itemDef
		{
			name				applyjoinblueButton
			group				highlights
			style				WINDOW_STYLE_SHADER
			rect				150 175 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
			cvartest			"g_gametype"
			showcvar			{ "6", "8" }
		}

		// GalaxyRP: [Team modes] manual Blue team pick for Team FFA/CTF -- same purpose as applyjoinred above.
		itemDef
		{
			name				applyjoinblue
			group				none
			text				@MENUS_TEAM_BLUE
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				150 175 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			0.2 0.2 1 1
			descText			@MENUS_APPLY_CHANGES_AND_JOIN
			cvartest			"g_gametype"
			showcvar			{ "6", "8" }
			visible			1
			action
			{
				play			"sound/interface/button1"
				exec			"cmd team blue"
				hide			highlights
				uiScript 		closeingame
			}
			mouseEnter
			{
				show			applyjoinblueButton
			}
			mouseExit
			{
				hide			applyjoinblueButton
			}
		}

// APPLY SPECTATOR
		itemDef 
		{
			name				applyspectateButton
			group				highlights 
			style				WINDOW_STYLE_SHADER
			rect				150 140 105 32
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			1 1 1 1
			decoration
			visible			0
		}

		// GalaxyRP: [Profile UI] same simplification as applyjoin above -- plain team-spectate command
		// instead of routing through uiScript setForce, which is why this used to silently fail to
		// work for a player who was already in-game (see the matching comment on applyjoin).
		itemDef
		{
			name				applyspectate
			group				none
			text				@MENUS_SPECTATE
			type				1
			style				WINDOW_STYLE_EMPTY
			rect				150 140 105 32
			textalign			ITEM_ALIGN_CENTER
			textalignx			52
			textaligny			2
			font				2
			textscale			1
			forecolor			1 .682 0 1
			descText			@MENUS_APPLY_CHANGES_BUT_REMAIN
			visible			1
			action
			{
				play			"sound/interface/button1"
				exec			"cmd team s"
				hide			highlights
				uiScript 		closeingame
			}
			mouseEnter
			{
				show			applyspectateButton
			}
			mouseExit
			{
				hide			applyspectateButton
			}
		}
	}
}
