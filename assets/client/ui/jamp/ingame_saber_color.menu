//-----------------------------------
// Lightsaber Creation -- Screen 2 (color)
//
// GalaxyRP: [Saber RGB] reached from ingame_saber.menu's "Select saber color" link. Shows a live
// preview of each saber (as picked on screen 1, or as currently owned) with a row of color icons
// below it -- the six existing base-palette colors, the new black icon, and the new RGB icon (which
// reveals three sliders for a direct custom tone). A single Apply button at the bottom commits both
// the hilt selection made on screen 1 (still pending in ui_saber/ui_saber2) and the colors picked
// here in one action, then closes -- unlike TaystJK-JAPro's reference file, which needs its own inner
// Apply for the RGB panel before the real Apply.
//
// Layout note: kept inside the engine's 640x480 virtual UI coordinate space (SCREEN_WIDTH/HEIGHT in
// q_shared.h) -- two full saber blocks stacked vertically is tight at that resolution, so this is a
// compact first pass; expect to want to tune spacing after seeing it in-game.
//-----------------------------------
{
	menuDef
	{
		name						"ingame_saber_color"
		visible					0
		fullscreen					0
		outOfBoundsClick
		rect						105 5 430 460
		focusColor					1 1 1 1
		style						1
		border					1
		descX						320
		descY						470
		descScale					1
		descColor					1 .682 0 1
		descAlignment				ITEM_ALIGN_CENTER

		onOpen
		{
			hide				highlights
			uiScript  			"getsabercvars"
			hide				rgbpanel1
			hide				rgbpanel2
		}
		onClose
		{
			hide				highlights
		}

//---> Overall window backdrop

		itemDef
		{
			name				background_pic
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 430 460
			background			"gfx/menus/menu_box_ingame"
			forecolor			1 1 1 1
			visible				1
			decoration
		}

//---> Screen title

		itemDef
		{
			name				colortitle
			style				WINDOW_STYLE_SHADER
			background			"gfx/menus/menu_blendbox"
			text				"Select Saber Color"
			rect				20 5 390 26
			textalign			ITEM_ALIGN_CENTER
			textalignx			195
			textaligny			2
			outlinecolor			1 .5 .5 .5
			backcolor			0 0 0 0
			font				3
			textscale			0.9
			forecolor			1  1  1  1
			border				0
			bordercolor			0 0 0 0
			visible				1
		}

//---> Back link -- returns to screen 1 without discarding pending picks (plain cvars survive
// the close/open, both here and on screen 1)

		itemDef
		{
			name				backlink
			group				none
			text				"Back to hilt selection"
			descText			"Return to saber type and hilt selection"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				15 33 200 12
			font				2
			textscale			0.7
			textstyle			0
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			0
			forecolor			.549 .854 1 1
			visible				1
			mouseEnter
			{
				setitemcolor		backlink forecolor 1 1 1 1
			}
			mouseExit
			{
				setitemcolor		backlink forecolor .549 .854 1 1
			}
			action
			{
				play			"sound/interface/button1.wav"
				close			ingame_saber_color
				open			ingame_saber
			}
		}

////////////////////////
// FIRST SABER -- preview, color icons, RGB sliders
////////////////////////

		itemDef
		{
			name				saber
			group				models
			type 				ITEM_TYPE_MODEL
			rect				20 46 390 85
			asset_model			"models/weapons2/saber_reborn/saber_w.glm"
			isSaber			1
			model_angle			180
			model_rotation		20
			model_g2mins		0 0 0
			model_g2maxs		20 20 20
			model_fovx			40
			model_fovy			40
			visible			1
			decoration
		}

		itemDef
		{
			name				saber1colortitle
			group				none
			text				"First Saber"
			descText			"Choose a color for your first saber"
			style				WINDOW_STYLE_EMPTY
			rect				20 132 200 12
			font				2
			textscale			0.75
			textstyle			0
			textalignx			0
			textaligny			-3
			textalign			ITEM_ALIGN_LEFT
			backcolor			0 0 0 0
			forecolor			.549 .854 1 1
			visible			1
			decoration
		}

		itemDef
		{
			name			redicon
			group			sabericons
			style			WINDOW_STYLE_SHADER
			type			ITEM_TYPE_BUTTON
			rect			20 146 24 24
			background			"gfx/menus/saber_icon_red"
			forecolor			.75 .75 .75 1
			descText			"Red blade"
			border			1
			bordersize			1
			bordercolor			.33 .33 .5 1
			visible			1
			mouseEnter
			{
				setitemcolor		redicon forecolor 1 1 1 1
				setitemcolor		redicon bordercolor .66 .66 1 1
			}
			mouseExit
			{
				setitemcolor		redicon forecolor .75 .75 .75 1
				setitemcolor		redicon bordercolor .33 .33 .5 1
			}
			action
			{
				play			"sound/interface/choose_blade.wav"
				setcvar		ui_saber_color "red"
				hide			rgbpanel1
			}
		}

